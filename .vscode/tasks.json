{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "CMake: 配置 (Debug)",
            "command": "cmake",
            "args": ["--preset", "Debug"],
            "problemMatcher": []
        },
        {
            "type": "process",
            "label": "CMake: 清理 (Debug)",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build/Debug", "--target", "clean"],
            "dependsOn": "CMake: 配置 (Debug)",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "process",
            "label": "CMake: 编译 (Debug)",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build/Debug", "--target", "all"],
            "dependsOn": "CMake: 配置 (Debug)",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "process",
            "label": "CMake: 重新编译 (Debug)",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build/Debug", "--clean-first", "--target", "all"],
            "dependsOn": "CMake: 配置 (Debug)",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "process",
            "label": "STM32: 编译并烧录 (OpenOCD)",
            "command": "openocd",
            "args": [
                "-s", "${env:OPENOCD_SCRIPTS}",
                "-f", "interface/stlink-dap.cfg",
                "-f", "target/stm32f1x.cfg",
                "-c", "adapter speed 1000",
                "-c", "program {${workspaceFolder}/build/Debug/phc.elf} verify reset exit"
            ],
            "dependsOn": "CMake: 编译 (Debug)",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
