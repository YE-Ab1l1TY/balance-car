{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32: 编译、烧录并调试 (OpenOCD)",
            "type": "stgdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: 编译 (Debug)",
            "program": "${workspaceFolder}/build/Debug/phc.elf",
            "gdb": "arm-none-eabi-gdb",
            "deviceName": "STM32F103C8T6",
            "deviceCore": "Cortex-M3",
            "serverExe": "openocd",
            "serverCwd": "${workspaceFolder}",
            "serverParameters": [
                "-s", "${env:OPENOCD_SCRIPTS}",
                "-f", "interface/stlink-dap.cfg",
                "-f", "target/stm32f1x.cfg",
                "-c", "adapter speed 1000"
            ],
            "serverHost": "localhost",
            "serverPort": "3333",
            "serverStartupDelay": 1000,
            "automaticallyKillServer": true,
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/phc.elf",
                    "symbolFileName": "${workspaceFolder}/build/Debug/phc.elf"
                }
            ]
        }
    ]
}
